# Required: your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Optional: require this code before anyone can run the shopping agent
# (it spends your API credits). Leave blank to allow everyone.
CARTPASS_ACCESS_CODE=

# Optional: short links (cartpass.app/c/Ab3dE9) instead of long self-contained links.
# Add Upstash Redis from the Vercel Marketplace and these are filled in for you.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: your Amazon Associates tag, added to Amazon cart links.
AMAZON_ASSOCIATE_TAG=

# Optional: override the model (defaults to claude-opus-5-5).
CARTPASS_MODEL=
